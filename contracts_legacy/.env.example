# Deployment Private Key (Without 0x prefix)
PRIVATE_KEY="your_private_key_here"

# Base Testnet (Sepolia) RPC URL
RPC_URL="https://sepolia.base.org"

# Etherscan/Basescan API Key for contract verification
ETHERSCAN_API_KEY="your_basescan_api_key_here"

# (Optional) Address that receives DEFAULT_ADMIN_ROLE / UPGRADER_ROLE.
# Defaults to the deployer address if unset. Prefer a multisig for production.
ADMIN_ADDRESS=""

# (Optional) Trusted Forwarder for meta-transactions / gas sponsorship.
# Leave as the zero address to auto-deploy the bundled DryChainForwarder.
# Or paste a Biconomy / Gelato / custom forwarder address.
FORWARDER_ADDRESS="0x0000000000000000000000000000000000000000"

# --- Populated after deployment (used by upgrade / grant-role scripts) ---
ROLE_MANAGER_ADDRESS=""
BATCH_REGISTRY_ADDRESS=""

# For GrantRole.s.sol
GRANTEE=""
ROLE="DRYER_OPERATOR" # FIELD_OFFICER | DRYER_OPERATOR | LOGISTICS
