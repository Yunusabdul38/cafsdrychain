datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  OPERATOR
}

enum UserStatus {
  /// Invited, but has not chosen a password yet — cannot sign in.
  PENDING
  ACTIVE
  INACTIVE
}

enum BatchStage {
  REGISTERED
  AWAITING_PAYMENT
  DRYING
  DRIED
  STORED
  IN_TRANSIT
  DELIVERED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum ChainStatus {
  PENDING
  CONFIRMED
  FAILED
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  name               String
  role               Role           @default(OPERATOR)
  status             UserStatus     @default(ACTIVE)
  location           String?
  passwordHash       String
  /// Unused. Never enforced, and invited users choose their own password.
  /// Drop in the cleanup migration alongside `supplier` and `transport`.
  mustChangePassword Boolean        @default(true)
  wallet             Wallet?
  batches            Batch[]              @relation("BatchOperator")
  refreshTokens      RefreshToken[]
  passwordResets     PasswordResetToken[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

enum TokenPurpose {
  /// Sent to a new user so they can choose their first password.
  INVITE
  /// Sent to an existing user who forgot theirs.
  RESET
}

/// Hashed, single-use tokens for setting a password. One model covers both the
/// first-time invitation and a later reset; only the lifetime and wording differ.
model PasswordResetToken {
  id        String       @id @default(uuid())
  purpose   TokenPurpose @default(RESET)
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// One deterministic HD wallet per user. Private keys are NEVER stored —
/// they are re-derived on demand from the master seed + `index`.
model Wallet {
  id             String   @id @default(uuid())
  address        String   @unique
  index          Int      @unique
  chain          String   @default("base")
  derivationPath String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String   @unique
  createdAt      DateTime @default(now())
}

/// Single-row atomic counter guaranteeing every new wallet gets the next
/// unused HD index, even under concurrent signups.
model WalletCounter {
  id    Int @id @default(1)
  value Int @default(0)
}

model Batch {
  id              String       @id @default(uuid())
  batchId         String       @unique // human id e.g. DRY-2K7F-9X1
  /// Produce category (Fruit, Vegetable, Crop, Livestock, …). Defaulted so the
  /// column could be added to databases that already held batches.
  category        String       @default("Uncategorized")
  product         String
  sourceType      String
  source          String
  /// No longer collected at registration; nullable so existing rows keep their
  /// value. Drop in a cleanup migration alongside `transport`.
  supplier        String?
  freshWeight     Float
  finalWeight     Float?
  moisture        Float?
  /// When the operator confirmed registration. Kept on the original column
  /// name so the rename needs no migration.
  entryDate       DateTime     @map("deliveryDate")
  dryingStart     DateTime?
  dryingEnd       DateTime?
  /// How the batch was dried (solar tunnel, cabinet, hybrid…).
  dryingMethod    String?
  quality         String?
  storageLocation String?
  packaging       String?
  transport       String?
  destination     String?
  stage           BatchStage   @default(REGISTERED)
  location        String
  metadataHash    String
  chainStatus     ChainStatus  @default(PENDING)
  txHash          String?
  operator        User         @relation("BatchOperator", fields: [operatorId], references: [id])
  operatorId      String
  events          BatchEvent[]
  payment         Payment?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model BatchEvent {
  id           String      @id @default(uuid())
  batch        Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId      String
  stage        BatchStage
  title        String
  actor        String
  /// Free-text comment the operator left when recording this step.
  note         String?
  metadataHash String
  txHash       String?
  chainStatus  ChainStatus @default(PENDING)
  createdAt    DateTime    @default(now())
}

/// The drying fee for one batch. Drying cannot start until this is PAID.
/// `amount` is held in kobo (NGN minor units) as an integer — money is never
/// stored as a float.
model Payment {
  id          String        @id @default(uuid())
  batch       Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId     String        @unique
  amount      Int
  currency    String        @default("NGN")
  /// Which gateway issued the link ("stub" until a real provider is wired up).
  provider    String
  /// Provider-side idempotency key; what webhooks are matched on.
  reference   String        @unique
  checkoutUrl String
  status      PaymentStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

/// Hashed, rotating refresh tokens for session management.
model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  /// Last time this session was exchanged. Sessions idle beyond the configured
  /// window are refused even though the token has not formally expired.
  lastUsedAt DateTime @default(now())
  createdAt DateTime @default(now())
}

/// Admin-managed list of solar drying hubs / locations.
model Location {
  id        String   @id @default(uuid())
  name      String   @unique
  /// Whether this hub charges a drying fee. Gated by AppSettings.feesEnabled:
  /// the global switch turns collection off everywhere, and this decides which
  /// hubs collect when it is on.
  ///
  /// New hubs start off. Charging a supplier is a decision someone should make
  /// deliberately, not something a hub inherits by being created.
  feesEnabled Boolean @default(false)
  createdAt DateTime @default(now())
}

/// Single-row admin configuration. `feesEnabled` is the master switch for
/// drying fees; which hubs actually collect is set per hub on Location.
model AppSettings {
  id          Int      @id @default(1)
  feesEnabled Boolean  @default(true)
  /// Retired in favour of the per-hub toggle. Nothing reads it. The column
  /// stays because Railway deploys with `prisma db push`, which refuses a
  /// destructive change — drop it in the cleanup migration.
  minimumFee  Int      @default(0)
  updatedAt   DateTime @updatedAt
}

/// Security / compliance audit trail of sensitive actions.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  ip        String?
  meta      Json?
  createdAt DateTime @default(now())
}
