# ---- Core ----
NODE_ENV="development"
PORT=5000
DATABASE_URL="postgresql://username:password@localhost:5432/cafsdrychain?schema=public"

# ---- Auth (generate each with: openssl rand -base64 48) ----
JWT_ACCESS_SECRET="replace-with-a-long-random-string-min-32-chars"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string-min-32"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7

# ---- CORS (comma-separated allowlist) ----
CORS_ORIGINS="http://localhost:3000"
APP_URL="http://localhost:3000"

# ---- Deterministic wallets ----
# 12/24-word BIP-39 mnemonic. In production this MUST be KMS/HSM-backed and
# never committed. Generate a fresh one per environment.
MASTER_MNEMONIC=""
COIN_TYPE=60
WALLET_CHAIN="base"

# ---- On-chain integration (optional; app runs off-chain until enabled) ----
CHAIN_ENABLED="false"
RPC_URL="https://sepolia.base.org"
CHAIN_ID=84532
ROLE_MANAGER_ADDRESS=""
BATCH_REGISTRY_ADDRESS=""
FORWARDER_ADDRESS=""
# Master/relayer wallet: pays gas AND holds the on-chain admin role.
RELAYER_PRIVATE_KEY=""

# ---- Email (Resend) ----
RESEND_API_KEY=""

# ---- Seed (npm run seed) ----
SEED_ADMIN_EMAIL="admin@cafsdrychain.io"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
