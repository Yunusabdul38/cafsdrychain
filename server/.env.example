# ---- Core ----
NODE_ENV="development"
PORT=5000
DATABASE_URL="postgresql://username:password@localhost:5432/cafsdrychain?schema=public"

# ---- Auth (generate each with: openssl rand -base64 48) ----
JWT_ACCESS_SECRET="replace-with-a-long-random-string-min-32-chars"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string-min-32"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7
# A session unused for this long is refused on its next refresh. The browser
# signs the user out on the same schedule. Optional; defaults to 60.
SESSION_IDLE_MINUTES=60

# ---- Public URLs ----
# Origins allowed to call this API. In production this is the deployed
# frontend, e.g. "https://cafsdrychain.vercel.app". Comma-separate several.
CORS_ORIGINS="http://localhost:3000"
#
# REQUIRED IN PRODUCTION. Every invitation, password-reset and payment link is
# built from this. It defaults to localhost, so leaving it unset silently emails
# people links they cannot open. The server logs "MISCONFIGURED" at boot if this
# still points at localhost while NODE_ENV=production.
APP_URL="http://localhost:3000"

# ---- Deterministic wallets ----
# Generate with:  npm run keys
#
# MASTER_MNEMONIC is REQUIRED: the backend re-derives each operator's key to sign
# their meta-tx, so the operator's own EOA is the on-chain signer (_msgSender()).
# Keep it KMS/HSM-backed in production; never commit it.
MASTER_MNEMONIC=""
# Optional: set MASTER_XPUB INSTEAD of the mnemonic on a separate, watch-only API
# instance that only derives addresses (the signer instance keeps the mnemonic).
MASTER_XPUB=""
COIN_TYPE=60
WALLET_CHAIN="base"

# ---- On-chain integration (optional; app runs off-chain until enabled) ----
CHAIN_ENABLED="false"
RPC_URL="https://sepolia.base.org"
CHAIN_ID=84532
ROLE_MANAGER_ADDRESS=""
BATCH_REGISTRY_ADDRESS=""
FORWARDER_ADDRESS=""
# Relayer/master wallet: pays gas for every meta-tx AND holds the RoleManager
# admin role (so it can grant operators their roles). Operators sign; this wallet
# only relays + sponsors. Keep it funded and secured.
RELAYER_PRIVATE_KEY=""
# Relayer balance (ETH) below which admins are warned to top up on the Settings
# page. Half this value is treated as critical. Optional; defaults to 0.01.
RELAYER_LOW_BALANCE=0.01

# ---- Payments ----
# Which gateway issues drying-fee links.
#
#   stub  - test only. Creates a link to an in-app page that settles the payment
#           by hand, with no money involved. The settle route refuses to run when
#           NODE_ENV=production, so fee links issued in production would be
#           unpayable. Keep drying fees switched OFF (Admin > Settings) for as
#           long as this is the provider.
#   paystack / flutterwave - not implemented yet. Add a class satisfying
#           PaymentProvider in src/payments/ and register it in index.ts.
PAYMENT_PROVIDER="stub"

# ---- Email (Resend) ----
RESEND_API_KEY=""
# Where the public contact form delivers, e.g. "hello@yourdomain.com".
# If unset the message is written to the server log rather than dropped, so a
# missing value is visible instead of silently losing what someone wrote.
# The sending domain must be verified in Resend.
CONTACT_EMAIL=""

# ---- Seed (npm run seed) ----
# Creates the first admin if that email does not already exist. Use a mailbox
# that can actually receive mail: it is the only way back in if the password is
# lost, and it is where invitation and reset mail is tested from.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
