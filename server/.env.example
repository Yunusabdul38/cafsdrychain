# ---- Core ----
NODE_ENV="development"
PORT=5000
# info (default) shows failures, slow or refused requests and startup events.
# debug adds every routine request — useful when chasing one, noisy otherwise.
LOG_LEVEL="info"
DATABASE_URL="postgresql://username:password@localhost:5432/cafsdrychain?schema=public"

# ---- Auth (generate each with: openssl rand -base64 48) ----
JWT_ACCESS_SECRET="replace-with-a-long-random-string-min-32-chars"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string-min-32"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7
# A session unused for this long is refused on its next refresh. The browser
# signs the user out on the same schedule. Optional; defaults to 60.
SESSION_IDLE_MINUTES=60

# ---- Public URLs ----
# Origins allowed to call this API — the deployed frontend, e.g.
# "https://www.cafsdrychain.com". Comma-separate several.
CORS_ORIGINS="http://localhost:3000"

# REQUIRED IN PRODUCTION. Every invitation, password-reset and payment link is
# built from this. It defaults to localhost, so leaving it unset silently emails
# people links they cannot open. The server logs "MISCONFIGURED" at boot if this
# still points at localhost while NODE_ENV=production.
APP_URL="http://localhost:3000"

# ---- Features ----
# Stop collecting moisture readings, for hubs with no meter. "true" hides the
# field on the drying form and the server ignores any value sent, recording no
# reading at all (not 0%). The column stays, so this can be switched back on
# with no migration. The site picks it up from the server — nothing to set on
# Vercel — but restart the server after changing it.
HIDE_MOISTURE="false"

# ---- Deterministic wallets ----
# Generate with:  npm run keys
#
# MASTER_MNEMONIC is REQUIRED: the backend re-derives each operator's key to sign
# their meta-tx, so the operator's own EOA is the on-chain signer (_msgSender()).
# Keep it KMS/HSM-backed in production; never commit it.
MASTER_MNEMONIC=""
# Optional: set MASTER_XPUB INSTEAD of the mnemonic on a separate, watch-only API
# instance that only derives addresses (the signer instance keeps the mnemonic).
MASTER_XPUB=""
COIN_TYPE=60
WALLET_CHAIN="base"

# ---- On-chain integration (optional; app runs off-chain until enabled) ----
CHAIN_ENABLED="false"
#
# Network is chosen here and must be set as a pair — an RPC pointing at one
# chain with the other's CHAIN_ID makes every meta-transaction signature
# invalid, because the chain id is part of what operators sign.
#
#   Base mainnet   RPC a provider endpoint (the public https://mainnet.base.org
#                  is rate-limited and drops requests under load), CHAIN_ID 8453
#   Base Sepolia   https://sepolia.base.org, CHAIN_ID 84532
#
# The contract addresses below are per network too: a mainnet deploy produces
# new ones, and the testnet addresses do not exist there.
RPC_URL="https://sepolia.base.org"
CHAIN_ID=84532
ROLE_MANAGER_ADDRESS=""
BATCH_REGISTRY_ADDRESS=""
FORWARDER_ADDRESS=""
# Relayer/master wallet: pays gas for every meta-tx AND holds the RoleManager
# admin role (so it can grant operators their roles). Operators sign; this wallet
# only relays + sponsors. Keep it funded and secured.
RELAYER_PRIVATE_KEY=""
# Relayer balance (ETH) below which admins are warned to top up on the Settings
# page. Half this value is treated as critical. Optional; defaults to 0.01.
RELAYER_LOW_BALANCE=0.01

# ---- Contract verification (contracts/ only) ----
# One Etherscan V2 key covers Base and Base Sepolia. Needed by
# `forge script ... --verify` so a new implementation is verified on deploy;
# without it the explorer shows batch event logs as raw hex.
ETHERSCAN_API_KEY=""

# ---- Payments ----
# "bachs" is the only provider implemented. Read lazily and only where a drying
# fee applies, so with fees off in Admin > Settings the keys below can stay empty.
PAYMENT_PROVIDER="bachs"
#
# THE KEY PREFIX PICKS THE ENVIRONMENT — going live is this one value:
#   sk_sandbox_...  ->  sandbox-api.bachs.io   (test money)
#   sk_live_...     ->  api.bachs.io           (real money)
# The server logs which it started in ("Bachs payments configured", mode=...).
# Scope the key to Payments only; it never needs to send payouts.
BACHS_SECRET_KEY=""
#
# Optional. Without it webhooks cannot be verified and are ignored, so a fee
# stays PENDING until an operator presses "Check now" on the batch.
# Production: Developer Portal > Webhooks > signing secret, with the endpoint
#   pointing at https://<this-api-domain>/api/payments/webhook (public HTTPS,
#   not the frontend domain) and subscribed to collection.succeeded,
#   collection.failed and checkout.expired.
# Local: `bachs listen --forward-to localhost:5000/api/payments/webhook` prints
#   a whsec_ for that session.
BACHS_WEBHOOK_SECRET=""

# ---- Email (Resend) ----
RESEND_API_KEY=""

# ---- Seed (npm run seed) ----
# Creates the first admin if that email does not already exist. Use a mailbox
# that can actually receive mail: it is the only way back in if the password is
# lost, and it is where invitation and reset mail is tested from.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
